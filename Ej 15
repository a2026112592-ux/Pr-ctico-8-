
#include <iostream>
#include <string>
using namespace std;
const int MAX = 100;
void leerEstudiantes(string nom[], double nots[], int n);
void ordenarBurbujaParalelo(string nom[], double nots[], int n);
void mostrarTresMejores(const string nom[], const double nots[], int n);
int main() {
int n; string nombres[MAX]; double notas[MAX];
cout<<"Cantidad de estudiantes (>=3): "; cin>>n;
if(n>=3 && n<=MAX) {
leerEstudiantes(nombres, notas, n);
ordenarBurbujaParalelo(nombres, notas, n);
mostrarTresMejores(nombres, notas, n);
}
return 0;
}
void leerEstudiantes(string nom[], double nots[], int n) {
for(int i=0; i<n; i++) {
cout<<"Nombre "<<i+1<<": "; cin>>nom[i];
do {
cout<<"Nota "<<i+1<<" (0-100): "; cin>>nots[i];
} while(nots[i]<0 || nots[i]>100);
}
}
void ordenarBurbujaParalelo(string nom[], double nots[], int n) {
for(int i=0; i<n-1; i++) {
for(int j=0; j<n-i-1; j++) {
if(nots[j] < nots[j+1]) {
double tempNota = nots[j]; nots[j] = nots[j+1]; nots[j+1] = tempNota;
string tempNom = nom[j]; nom[j] = nom[j+1]; nom[j+1] = tempNom;
}
}
}
}
void mostrarTresMejores(const string nom[], const double nots[], int n) {
cout<<"\n--- TRES MEJORES ESTUDIANTES ---\n";
for(int i=0; i<3 && i<n; i++) cout<<i+1<<". "<<nom[i]<<" - Nota: "<<nots[i]<<"\n";
}
