
#include <iostream>
using namespace std;
const int MAX = 100;
void leerVector(int v[], int n, string nombre);
void intercalar(const int A[], int n, const int B[], int m, int C[], int &k);
void mostrar(const int v[], int n, string nombre);
int main() {
int n, m, k; int A[MAX], B[MAX], C[2*MAX];
cout<<"Tamano A: "; cin>>n; leerVector(A, n, "A");
cout<<"Tamano B: "; cin>>m; leerVector(B, m, "B");
intercalar(A, n, B, m, C, k);
mostrar(C, k, "C (Intercalado)");
return 0;
}
void leerVector(int v[], int n, string nombre) {
cout<<"Ingrese elementos ordenados ascendentemente para "<<nombre<<"\n";
for(int i=0; i<n; i++){ cout<<nombre<<"["<<i<<"]: "; cin>>v[i]; }
}
void intercalar(const int A[], int n, const int B[], int m, int C[], int &k) {
int i=0, j=0; k=0;
while(i<n && j<m) {
if(A[i] <= B[j]) C[k++] = A[i++];
else C[k++] = B[j++];
}
while(i<n) C[k++] = A[i++];
while(j<m) C[k++] = B[j++];
}
void mostrar(const int v[], int n, string nombre) {
cout<<nombre<<": ";
for(int i=0; i<n; i++) cout<<v[i]<<" "; cout<<"\n";
}
