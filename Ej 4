#include <iostream>
using namespace std;
const int MAX = 100;
void leerVector(int v[], int n);
void invertir(const int A[], int B[], int n);
void mostrar(const int v[], int n, string nombre);
int main() {
int n; int A[MAX], B[MAX];
cout<<"Cantidad de elementos: "; cin>>n;
if(n>0 && n<=MAX) {
leerVector(A, n);
invertir(A, B, n);
mostrar(A, n, "Vector A (Original)");
mostrar(B, n, "Vector B (Invertido)");
}
return 0;
}
void leerVector(int v[], int n) {
for(int i=0; i<n; i++){ cout<<"A["<<i<<"]: "; cin>>v[i]; }
}
void invertir(const int A[], int B[], int n) {
for(int i=0; i<n; i++) B[i] = A[n-1-i];
}
void mostrar(const int v[], int n, string nombre) {
cout<<nombre<<": ";
for(int i=0; i<n; i++) cout<<v[i]<<" ";
cout<<"\n";
}
