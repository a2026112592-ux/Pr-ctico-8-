#include <iostream>
using namespace std;
const int MAX = 100;
void leerVector(double v[], int n);
double calcularPromedio(const double v[], int n);
void mostrar(double prom);
int main() {
int n; double v[MAX];
cout<<"Cantidad de elementos: "; cin>>n;
if(n>0 && n<=MAX) { leerVector(v, n); mostrar(calcularPromedio(v, n)); }
return 0;
}
void leerVector(double v[], int n) {
for(int i=0; i<n; i++){ cout<<"v["<<i<<"]: "; cin>>v[i]; }
}
double calcularPromedio(const double v[], int n) {
double suma = 0;
for(int i=0; i<n; i++) suma+=v[i];
return suma/n;
}
void mostrar(double prom) { cout<<"Promedio: "<<prom<<"\n"; }
